# Copy to .env in the repository root and replace the placeholders.
# Never commit the real .env file.

DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=replace-with-a-long-random-string
POSTGRES_DB=pulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-local-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave EMAIL_HOST_PASSWORD empty to print verification links in the API window.
# Gmail delivery needs smtp.gmail.com, port 587, TLS, and a Google app password.
# DEFAULT_FROM_EMAIL must be that same Gmail address. The normal Gmail password will be rejected.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
