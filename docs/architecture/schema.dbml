// Pulse canonical schema. Import into DrawSQL or another DBML tool.
// Monetary amounts are bigint minor units (paise for INR). Never float.
// Tenant-owned child rows use a composite foreign key on (company_id, parent_id)
// whenever the parent row is also tenant-owned.
// PostgreSQL enums are intentionally not used. Allowed values are check constraints
// documented on each status column and in 03-database-design.md.
// Partial unique indexes that DBML cannot express are marked with notes.

Project pulse {
  database_type: "PostgreSQL"
  Note: "Pulse modular monolith. INR-first billing. Shared schema multi-tenancy."
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

Table users {
  id uuid [pk, not null]
  email varchar(254) [not null, unique, note: "Global login identity. Stored lowercase."]
  password_hash varchar(255) [not null]
  first_name varchar(150) [not null, default: ""]
  last_name varchar(150) [not null, default: ""]
  is_active boolean [not null, default: true]
  email_verified_at timestamptz
  last_login_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: "Global user account. Not a company membership and not a person record. Platform access is not a column on this table."
}

Table email_verification_tokens {
  id uuid [pk, not null]
  user_id uuid [not null]
  token_hash varchar(255) [not null, unique]
  expires_at timestamptz [not null]
  used_at timestamptz
  created_at timestamptz [not null]

  indexes {
    user_id [name: "email_verification_tokens_user_idx"]
  }
}

Table password_reset_tokens {
  id uuid [pk, not null]
  user_id uuid [not null]
  token_hash varchar(255) [not null, unique]
  expires_at timestamptz [not null]
  used_at timestamptz
  created_at timestamptz [not null]

  indexes {
    user_id [name: "password_reset_tokens_user_idx"]
  }
}

// Django's django_session table is created by the framework. It is not redefined here.

// ---------------------------------------------------------------------------
// Tenants and onboarding
// ---------------------------------------------------------------------------

Table companies {
  id uuid [pk, not null]
  slug varchar(63) [not null, unique, note: "Workspace URL key. Globally unique."]
  legal_name varchar(255) [not null]
  display_name varchar(255) [not null]
  status varchar(32) [not null, note: "Check: draft, active, suspended, closed. Company lifecycle, not billing."]
  country_code char(2) [not null, default: "IN"]
  timezone varchar(64) [not null, default: "Asia/Kolkata"]
  created_by_user_id uuid
  suspended_at timestamptz
  closed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    status [name: "companies_status_idx"]
    created_at [name: "companies_created_at_idx"]
  }
}

Table company_billing_profiles {
  id uuid [pk, not null]
  company_id uuid [not null, unique]
  billing_name varchar(255) [not null]
  billing_email varchar(254) [not null]
  phone varchar(32)
  address_line1 varchar(255) [not null]
  address_line2 varchar(255)
  city varchar(100) [not null]
  state_code varchar(8) [not null, note: "GST state code of the billed company."]
  postal_code varchar(16) [not null]
  country_code char(2) [not null, default: "IN"]
  gstin varchar(15) [note: "Nullable. Format validated when present. Legal applicability is unresolved."]
  place_of_supply_state_code varchar(8) [note: "Snapshot source for invoices. Tax treatment requires confirmation."]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table company_memberships {
  id uuid [pk, not null]
  company_id uuid [not null]
  user_id uuid [not null]
  person_id uuid [note: "Optional link to a person in the same company."]
  status varchar(32) [not null, note: "Check: invited, active, suspended, removed."]
  joined_at timestamptz
  removed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (company_id, id) [unique, name: "company_memberships_company_id_id_unique"]
    (company_id, user_id) [unique, name: "company_memberships_company_user_unique"]
    (company_id, person_id) [unique, name: "company_memberships_company_person_unique", note: "Partial unique WHERE person_id IS NOT NULL."]
    user_id [name: "company_memberships_user_idx"]
    (company_id, status) [name: "company_memberships_company_status_idx"]
  }
}

Table membership_invitations {
  id uuid [pk, not null]
  company_id uuid [not null]
  email varchar(254) [not null]
  person_id uuid
  invited_by_user_id uuid [not null]
  token_hash varchar(255) [not null, unique]
  status varchar(32) [not null, note: "Check: pending, accepted, revoked, expired."]
  expires_at timestamptz [not null]
  accepted_at timestamptz
  accepted_by_user_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (company_id, email, status) [name: "membership_invitations_company_email_status_idx"]
    (company_id, id) [unique, name: "membership_invitations_company_id_id_unique"]
  }

  Note: "Partial unique: one pending invitation per (company_id, email)."
}

Table onboarding_states {
  id uuid [pk, not null]
  company_id uuid [not null, unique]
  owner_user_id uuid [not null]
  email_verified_at timestamptz
  company_created_at timestamptz
  profile_completed_at timestamptz
  billing_profile_completed_at timestamptz
  plan_selected_at timestamptz
  checkout_started_at timestamptz
  subscription_activated_at timestamptz
  workspace_entered_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: "Checklist timestamps, not a single linear status. A customer can resume at the first missing step."
}

Table company_settings {
  id uuid [pk, not null]
  company_id uuid [not null]
  key varchar(100) [not null]
  value jsonb [not null]
  updated_at timestamptz [not null]

  indexes {
    (company_id, key) [unique, name: "company_settings_company_key_unique"]
  }
}

// ---------------------------------------------------------------------------
// Organization and people
// ---------------------------------------------------------------------------

Table departments {
  id uuid [pk, not null]
  company_id uuid [not null]
  name varchar(150) [not null]
  parent_department_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (company_id, id) [unique, name: "departments_company_id_id_unique"]
    (company_id, name) [unique, name: "departments_company_name_unique"]
  }
}

Table people {
  id uuid [pk, not null]
  company_id uuid [not null]
  department_id uuid
  manager_person_id uuid
  employee_code varchar(64)
  first_name varchar(150) [not null]
  last_name varchar(150) [not null]
  work_email varchar(254)
  job_title varchar(150)
  employment_type varchar(32) [note: "Check when set: full_time, part_time, contractor, intern."]
  status varchar(32) [not null, note: "Check: active, inactive."]
  start_date date
  end_date date
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (company_id, id) [unique, name: "people_company_id_id_unique"]
    (company_id, employee_code) [unique, name: "people_company_employee_code_unique", note: "Partial unique WHERE employee_code IS NOT NULL."]
    (company_id, status) [name: "people_company_status_idx"]
    (company_id, department_id) [name: "people_company_department_idx"]
  }

  Note: "Company-owned person. Distinct from users and from company_memberships."
}

// ---------------------------------------------------------------------------
// Authorization
// ---------------------------------------------------------------------------

Table permissions {
  code varchar(100) [pk, not null]
  description text [not null]
  scope varchar(32) [not null, note: "Check: company, platform."]
  module_slug varchar(64) [note: "Null for core permissions."]

  Note: "Stable catalog seeded from code. Company roles may reference only scope=company. Platform grants may reference only scope=platform."
}

Table role_templates {
  id uuid [pk, not null]
  code varchar(64) [not null, unique, note: "owner, administrator, hr_manager, department_manager, employee."]
  name varchar(150) [not null]
  description text [not null, default: ""]
  is_system boolean [not null, default: true]
}

Table role_template_permissions {
  role_template_id uuid [not null]
  permission_code varchar(100) [not null]

  indexes {
    (role_template_id, permission_code) [pk, name: "role_template_permissions_pk"]
  }
}

Table company_roles {
  id uuid [pk, not null]
  company_id uuid [not null]
  template_code varchar(64)
  name varchar(150) [not null]
  description text [not null, default: ""]
  is_owner_role boolean [not null, default: false]
  is_system boolean [not null, default: false, note: "True for roles cloned from templates. The owner role has a protected permission floor."]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (company_id, id) [unique, name: "company_roles_company_id_id_unique"]
    (company_id, name) [unique, name: "company_roles_company_name_unique"]
  }
}

Table company_role_permissions {
  company_id uuid [not null]
  company_role_id uuid [not null]
  permission_code varchar(100) [not null]

  indexes {
    (company_role_id, permission_code) [pk, name: "company_role_permissions_pk"]
    (company_id, company_role_id) [name: "company_role_permissions_company_role_idx"]
  }

  Note: "permission_code must reference a permission with scope=company."
}

Table membership_role_assignments {
  id uuid [pk, not null]
  company_id uuid [not null]
  membership_id uuid [not null]
  company_role_id uuid [not null]
  assigned_by_user_id uuid
  created_at timestamptz [not null]

  indexes {
    (membership_id, company_role_id) [unique, name: "membership_role_assignments_unique"]
    (company_id, membership_id) [name: "membership_role_assignments_membership_idx"]
  }
}

Table platform_permission_grants {
  id uuid [pk, not null]
  user_id uuid [not null]
  permission_code varchar(100) [not null]
  granted_by_user_id uuid
  created_at timestamptz [not null]

  indexes {
    (user_id, permission_code) [unique, name: "platform_permission_grants_user_permission_unique"]
  }

  Note: "Independent of company roles. permission_code must have scope=platform."
}

// ---------------------------------------------------------------------------
// Module registry
// ---------------------------------------------------------------------------

Table module_definitions {
  slug varchar(64) [pk, not null]
  display_name varchar(150) [not null]
  description text [not null, default: ""]
  version varchar(32) [not null]
  django_app_label varchar(100) [not null]
  min_platform_version varchar(32) [not null]
  is_core boolean [not null, default: false]
  is_public boolean [not null, default: true]
  config_schema jsonb [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: "Global catalog row seeded from trusted in-repo module manifests. Not customer-uploaded code."
}

Table module_dependencies {
  module_slug varchar(64) [not null]
  depends_on_slug varchar(64) [not null]

  indexes {
    (module_slug, depends_on_slug) [pk, name: "module_dependencies_pk"]
  }

  Note: "Check: module_slug <> depends_on_slug."
}

Table company_module_installations {
  id uuid [pk, not null]
  company_id uuid [not null]
  module_slug varchar(64) [not null]
  installed_version varchar(32) [not null]
  status varchar(32) [not null, note: "Check: pending, installing, installed, failed, upgrading, uninstalling, uninstalled."]
  config jsonb [not null]
  last_error text
  installed_by_user_id uuid
  installed_at timestamptz
  uninstalled_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (company_id, module_slug) [unique, name: "company_module_installations_company_module_unique"]
    (company_id, status) [name: "company_module_installations_company_status_idx"]
  }
}

// ---------------------------------------------------------------------------
// Billing catalog
// ---------------------------------------------------------------------------

Table billing_plans {
  id uuid [pk, not null]
  code varchar(64) [not null, unique]
  name varchar(150) [not null]
  description text [not null, default: ""]
  is_active boolean [not null, default: true]
  is_public boolean [not null, default: true]
  trial_days integer [not null, default: 0, note: "Check: trial_days >= 0. Zero disables trial for the plan."]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table billing_plan_prices {
  id uuid [pk, not null]
  plan_id uuid [not null]
  billing_interval varchar(16) [not null, note: "Check: month, year."]
  currency char(3) [not null, note: "MVP check: currency = INR. Column remains for later currencies."]
  amount_minor bigint [not null, note: "Check: amount_minor >= 0. Paise when currency is INR. Catalog price, not a historical charge."]
  provider varchar(32) [note: "Null until synced. First adapter code: razorpay."]
  provider_price_ref varchar(255)
  is_active boolean [not null, default: true]
  effective_from timestamptz [not null]
  effective_to timestamptz
  created_at timestamptz [not null]

  indexes {
    (plan_id, billing_interval, currency, effective_from) [unique, name: "billing_plan_prices_version_unique"]
    (plan_id, billing_interval, currency) [name: "billing_plan_prices_lookup_idx"]
  }
}

Table billing_plan_entitlements {
  id uuid [pk, not null]
  plan_id uuid [not null]
  entitlement_key varchar(100) [not null, note: "Examples: max_people, max_installed_modules, included_module_slugs, dashboards_enabled."]
  entitlement_value jsonb [not null]

  indexes {
    (plan_id, entitlement_key) [unique, name: "billing_plan_entitlements_plan_key_unique"]
  }
}

Table billing_module_prices {
  id uuid [pk, not null]
  module_slug varchar(64) [not null]
  billing_interval varchar(16) [not null, note: "Check: month, year. Must match the company subscription interval when purchased."]
  currency char(3) [not null]
  amount_minor bigint [not null, note: "Check: amount_minor >= 0."]
  provider varchar(32)
  provider_price_ref varchar(255)
  is_active boolean [not null, default: true]
  effective_from timestamptz [not null]
  effective_to timestamptz
  created_at timestamptz [not null]

  indexes {
    (module_slug, billing_interval, currency, effective_from) [unique, name: "billing_module_prices_version_unique"]
  }
}

// ---------------------------------------------------------------------------
// Subscriptions, invoices, payments
// ---------------------------------------------------------------------------

Table billing_customers {
  id uuid [pk, not null]
  company_id uuid [not null, unique]
  provider varchar(32) [not null, note: "Domain provider code. First adapter: razorpay."]
  provider_customer_ref varchar(255) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (company_id, id) [unique, name: "billing_customers_company_id_id_unique"]
    (provider, provider_customer_ref) [unique, name: "billing_customers_provider_ref_unique"]
  }
}

Table billing_payment_methods {
  id uuid [pk, not null]
  company_id uuid [not null]
  billing_customer_id uuid [not null]
  provider varchar(32) [not null]
  provider_method_ref varchar(255) [not null]
  method_type varchar(32) [not null, note: "Check: card, upi, emandate, netbanking, other. Not every type supports recurring billing."]
  brand varchar(32)
  last4 varchar(4)
  status varchar(32) [not null, note: "Check: active, inactive, failed."]
  is_default boolean [not null, default: false]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (provider, provider_method_ref) [unique, name: "billing_payment_methods_provider_ref_unique"]
    company_id [name: "billing_payment_methods_company_idx"]
  }

  Note: "Stores provider references and display metadata only. Never store PAN, full account numbers, or UPI VPA secrets."
}

Table subscriptions {
  id uuid [pk, not null]
  company_id uuid [not null]
  plan_id uuid [not null]
  plan_price_id uuid [not null, note: "Catalog row chosen at signup or change. Charged amounts are snapshotted on items and invoices."]
  billing_interval varchar(16) [not null, note: "Check: month, year. Copied from the selected price."]
  currency char(3) [not null]
  status varchar(32) [not null, note: "Check: incomplete, trialing, active, past_due, canceled, unpaid."]
  provider varchar(32) [not null]
  provider_subscription_ref varchar(255)
  trial_ends_at timestamptz
  current_period_start timestamptz
  current_period_end timestamptz
  cancel_at_period_end boolean [not null, default: false]
  canceled_at timestamptz
  past_due_since timestamptz
  grace_ends_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (company_id, id) [unique, name: "subscriptions_company_id_id_unique"]
    (company_id, status) [name: "subscriptions_company_status_idx"]
    current_period_end [name: "subscriptions_period_end_idx"]
    (provider, provider_subscription_ref) [unique, name: "subscriptions_provider_ref_unique", note: "Partial unique WHERE provider_subscription_ref IS NOT NULL."]
  }

  Note: "Partial unique: one row per company_id where status <> canceled. That is the single current subscription."
}

Table subscription_items {
  id uuid [pk, not null]
  company_id uuid [not null]
  subscription_id uuid [not null]
  item_type varchar(32) [not null, note: "Check: plan, module."]
  plan_price_id uuid
  module_price_id uuid
  module_slug varchar(64)
  description varchar(255) [not null, note: "Snapshot of the commercial description."]
  billing_interval varchar(16) [not null, note: "Must equal subscriptions.billing_interval."]
  currency char(3) [not null]
  unit_amount_minor bigint [not null, note: "Price snapshot in minor units. Catalog price changes do not update this column."]
  quantity integer [not null, default: 1, note: "Check: quantity > 0."]
  provider_item_ref varchar(255)
  status varchar(32) [not null, note: "Check: pending, active, cancel_scheduled, canceled."]
  effective_at timestamptz
  ended_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (company_id, id) [unique, name: "subscription_items_company_id_id_unique"]
    (company_id, subscription_id) [name: "subscription_items_company_subscription_idx"]
    (subscription_id, item_type, status) [name: "subscription_items_type_status_idx"]
    (company_id, module_slug) [name: "subscription_items_company_module_idx"]
  }

  Note: "Check: item_type=plan implies plan_price_id IS NOT NULL AND module_price_id IS NULL. item_type=module implies module_price_id IS NOT NULL AND module_slug IS NOT NULL AND plan_price_id IS NULL. At most one plan item in pending or active status per subscription."
}

Table subscription_status_events {
  id uuid [pk, not null]
  company_id uuid [not null]
  subscription_id uuid [not null]
  from_status varchar(32)
  to_status varchar(32) [not null]
  reason varchar(255) [not null]
  provider_event_id uuid
  actor_user_id uuid
  created_at timestamptz [not null]

  indexes {
    (subscription_id, created_at) [name: "subscription_status_events_subscription_idx"]
  }

  Note: "Append-only subscription lifecycle history."
}

Table invoice_sequences {
  id uuid [pk, not null]
  prefix varchar(16) [not null]
  financial_year varchar(9) [not null, note: "Example: 2026-2027. Exact series format awaits accounting confirmation."]
  last_value integer [not null, default: 0]

  indexes {
    (prefix, financial_year) [unique, name: "invoice_sequences_prefix_year_unique"]
  }
}

Table invoices {
  id uuid [pk, not null]
  company_id uuid [not null]
  subscription_id uuid
  invoice_number varchar(64) [not null, unique]
  status varchar(32) [not null, note: "Check: draft, issued, paid, void, uncollectible."]
  currency char(3) [not null]
  billing_name_snapshot varchar(255) [not null]
  billing_address_snapshot jsonb [not null]
  gstin_snapshot varchar(15)
  place_of_supply_state_code varchar(8)
  supplier_legal_name_snapshot varchar(255) [not null]
  supplier_gstin_snapshot varchar(15)
  supplier_state_code_snapshot varchar(8)
  sac_code_snapshot varchar(16) [note: "Nullable until accounting confirms the SAC code."]
  period_start timestamptz
  period_end timestamptz
  subtotal_minor bigint [not null, note: "Sum of positive and negative line amounts before discount and tax."]
  discount_minor bigint [not null, default: 0, note: "Check: discount_minor >= 0."]
  taxable_minor bigint [not null, note: "Check: taxable_minor = subtotal_minor - discount_minor."]
  tax_minor bigint [not null, note: "Sum of invoice_tax_components.tax_minor."]
  total_minor bigint [not null, note: "Check: total_minor = taxable_minor + tax_minor."]
  issued_at timestamptz
  due_at timestamptz
  paid_at timestamptz
  provider varchar(32)
  provider_invoice_ref varchar(255)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (company_id, id) [unique, name: "invoices_company_id_id_unique"]
    (company_id, issued_at) [name: "invoices_company_issued_idx"]
    (company_id, status) [name: "invoices_company_status_idx"]
    subscription_id [name: "invoices_subscription_idx"]
  }

  Note: "Pulse-issued invoice. Provider receipts do not replace this row. Lines and tax components are immutable once status leaves draft."
}

Table invoice_lines {
  id uuid [pk, not null]
  company_id uuid [not null]
  invoice_id uuid [not null]
  subscription_item_id uuid
  line_type varchar(32) [not null, note: "Check: plan, module, proration_charge, proration_credit, adjustment."]
  description varchar(255) [not null]
  billing_interval varchar(16)
  quantity integer [not null, note: "Check: quantity > 0."]
  unit_amount_minor bigint [not null, note: "Snapshot. Negative only for proration_credit and adjustment."]
  amount_minor bigint [not null, note: "Pre-tax line amount snapshot."]
  period_start timestamptz
  period_end timestamptz
  created_at timestamptz [not null]

  indexes {
    (company_id, id) [unique, name: "invoice_lines_company_id_id_unique"]
    (company_id, invoice_id) [name: "invoice_lines_company_invoice_idx"]
  }
}

Table invoice_tax_components {
  id uuid [pk, not null]
  company_id uuid [not null]
  invoice_id uuid [not null]
  invoice_line_id uuid [not null]
  tax_code varchar(32) [not null, note: "Snapshot code such as CGST, SGST, IGST, or CESS. Not a hardcoded rate."]
  tax_rate_bps integer [not null, note: "Basis points snapshot. 1800 means 18.00 percent. Source is platform_tax_rates at issuance."]
  taxable_minor bigint [not null]
  tax_minor bigint [not null]
  created_at timestamptz [not null]

  indexes {
    (invoice_line_id, tax_code) [unique, name: "invoice_tax_components_line_code_unique"]
    invoice_id [name: "invoice_tax_components_invoice_idx"]
  }

  Note: "Immutable with the issued invoice. No single tax rate is assumed by the schema."
}

Table payment_transactions {
  id uuid [pk, not null]
  company_id uuid [not null]
  invoice_id uuid
  subscription_id uuid
  provider varchar(32) [not null]
  provider_payment_ref varchar(255)
  provider_order_ref varchar(255)
  idempotency_key varchar(255) [not null]
  status varchar(32) [not null, note: "Check: pending, authorized, captured, failed, refunded, partially_refunded."]
  currency char(3) [not null]
  amount_minor bigint [not null, note: "Check: amount_minor > 0."]
  failure_code varchar(64)
  failure_message text
  captured_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (company_id, id) [unique, name: "payment_transactions_company_id_id_unique"]
    (provider, idempotency_key) [unique, name: "payment_transactions_provider_idempotency_unique"]
    (provider, provider_payment_ref) [unique, name: "payment_transactions_provider_payment_unique", note: "Partial unique WHERE provider_payment_ref IS NOT NULL."]
    (company_id, created_at) [name: "payment_transactions_company_created_idx"]
    invoice_id [name: "payment_transactions_invoice_idx"]
  }
}

Table refunds {
  id uuid [pk, not null]
  company_id uuid [not null]
  payment_transaction_id uuid [not null]
  invoice_id uuid
  provider varchar(32) [not null]
  provider_refund_ref varchar(255)
  idempotency_key varchar(255) [not null]
  status varchar(32) [not null, note: "Check: pending, succeeded, failed."]
  currency char(3) [not null]
  amount_minor bigint [not null, note: "Check: amount_minor > 0. Sum of succeeded refunds cannot exceed the captured payment."]
  reason varchar(255) [not null]
  created_by_user_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (provider, idempotency_key) [unique, name: "refunds_provider_idempotency_unique"]
    (provider, provider_refund_ref) [unique, name: "refunds_provider_ref_unique", note: "Partial unique WHERE provider_refund_ref IS NOT NULL."]
    payment_transaction_id [name: "refunds_payment_idx"]
  }
}

Table payment_provider_events {
  id uuid [pk, not null]
  provider varchar(32) [not null]
  provider_event_id varchar(255) [not null]
  event_type varchar(100) [not null]
  payload jsonb [not null]
  signature_valid boolean [not null]
  processing_status varchar(32) [not null, note: "Check: received, processed, ignored, failed."]
  error text
  processed_at timestamptz
  created_at timestamptz [not null]

  indexes {
    (provider, provider_event_id) [unique, name: "payment_provider_events_provider_event_unique"]
    (processing_status, created_at) [name: "payment_provider_events_status_idx"]
  }

  Note: "Idempotency boundary for webhooks. Duplicate deliveries insert nothing and return the stored result."
}

// ---------------------------------------------------------------------------
// Platform operator billing configuration
// ---------------------------------------------------------------------------

Table platform_supplier_profile {
  id uuid [pk, not null]
  legal_name varchar(255) [not null]
  gstin varchar(15)
  state_code varchar(8) [not null]
  address jsonb [not null]
  invoice_prefix varchar(16) [not null]
  support_email varchar(254) [not null]
  updated_at timestamptz [not null]

  Note: "Singleton operator legal entity copied onto each issued invoice. Tax registration status is an unresolved legal item."
}

Table platform_tax_rates {
  id uuid [pk, not null]
  tax_code varchar(32) [not null]
  supply_scope varchar(32) [not null, note: "Check: intra_state, inter_state. Which codes apply is an unresolved tax decision."]
  rate_bps integer [not null, note: "Check: rate_bps >= 0."]
  sac_code varchar(16)
  effective_from date [not null]
  effective_to date
  is_active boolean [not null, default: false, note: "Inactive until accounting confirms the rate. Paid tax invoices are blocked while no active rows match the supply."]
  created_at timestamptz [not null]

  indexes {
    (tax_code, supply_scope, effective_from) [unique, name: "platform_tax_rates_version_unique"]
  }
}

Table platform_settings {
  key varchar(100) [pk, not null]
  value jsonb [not null]
  updated_at timestamptz [not null]

  Note: "Operator settings such as grace_period_days. Not company settings."
}

// ---------------------------------------------------------------------------
// Dashboards
// ---------------------------------------------------------------------------

Table widget_definitions {
  code varchar(100) [pk, not null]
  display_name varchar(150) [not null]
  description text [not null, default: ""]
  module_slug varchar(64) [note: "Null for core widgets."]
  required_permission varchar(100) [not null]
  config_schema jsonb [not null]
  is_active boolean [not null, default: true]

  Note: "Trusted widget catalog. A placed widget does not grant required_permission."
}

Table dashboards {
  id uuid [pk, not null]
  company_id uuid [not null]
  name varchar(150) [not null]
  description text [not null, default: ""]
  status varchar(32) [not null, note: "Check: draft, published, archived."]
  created_by_user_id uuid [not null]
  published_version_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (company_id, id) [unique, name: "dashboards_company_id_id_unique"]
    (company_id, name) [unique, name: "dashboards_company_name_unique"]
  }
}

Table dashboard_versions {
  id uuid [pk, not null]
  company_id uuid [not null]
  dashboard_id uuid [not null]
  version_number integer [not null, note: "Check: version_number > 0."]
  state varchar(32) [not null, note: "Check: draft, published, superseded."]
  layout jsonb [not null, note: "Validated grid. Not executable code."]
  change_note text [not null, default: ""]
  published_at timestamptz
  created_by_user_id uuid [not null]
  created_at timestamptz [not null]

  indexes {
    (dashboard_id, version_number) [unique, name: "dashboard_versions_dashboard_version_unique"]
    (company_id, id) [unique, name: "dashboard_versions_company_id_id_unique"]
  }
}

Table dashboard_widgets {
  id uuid [pk, not null]
  company_id uuid [not null]
  dashboard_version_id uuid [not null]
  widget_code varchar(100) [not null]
  grid_x integer [not null, note: "Check: grid_x >= 0."]
  grid_y integer [not null, note: "Check: grid_y >= 0."]
  grid_w integer [not null, note: "Check: grid_w > 0."]
  grid_h integer [not null, note: "Check: grid_h > 0."]
  config jsonb [not null]
  created_at timestamptz [not null]

  indexes {
    (company_id, dashboard_version_id) [name: "dashboard_widgets_version_idx"]
  }
}

Table dashboard_assignments {
  id uuid [pk, not null]
  company_id uuid [not null]
  dashboard_id uuid [not null]
  company_role_id uuid
  membership_id uuid
  priority integer [not null, default: 0]
  created_at timestamptz [not null]

  indexes {
    (company_id, company_role_id) [name: "dashboard_assignments_role_idx"]
    (company_id, membership_id) [name: "dashboard_assignments_membership_idx"]
  }

  Note: "Check: exactly one of company_role_id or membership_id is non-null."
}

// ---------------------------------------------------------------------------
// Notifications, audit, usage, jobs
// ---------------------------------------------------------------------------

Table notifications {
  id uuid [pk, not null]
  company_id uuid [note: "Null only for a platform-level notice to a user."]
  recipient_user_id uuid [not null]
  membership_id uuid
  notification_type varchar(100) [not null]
  title varchar(255) [not null]
  body text [not null, default: ""]
  payload jsonb [not null]
  read_at timestamptz
  created_at timestamptz [not null]

  indexes {
    (recipient_user_id, read_at, created_at) [name: "notifications_recipient_idx"]
    (company_id, recipient_user_id) [name: "notifications_company_recipient_idx"]
  }
}

Table audit_logs {
  id uuid [pk, not null]
  company_id uuid [note: "Null for platform-scoped actions."]
  actor_user_id uuid
  action varchar(100) [not null]
  object_type varchar(100) [not null]
  object_id uuid
  before jsonb
  after jsonb
  ip_address inet
  request_id uuid
  created_at timestamptz [not null]

  indexes {
    (company_id, created_at) [name: "audit_logs_company_created_idx"]
    (object_type, object_id) [name: "audit_logs_object_idx"]
    actor_user_id [name: "audit_logs_actor_idx"]
  }

  Note: "Append-only. Application role has INSERT and SELECT, not UPDATE or DELETE."
}

Table usage_records {
  id uuid [pk, not null]
  company_id uuid [not null]
  metric_key varchar(100) [not null, note: "Examples: people_active, modules_installed."]
  period_start date [not null]
  period_end date [not null]
  quantity integer [not null, note: "Check: quantity >= 0."]
  recorded_at timestamptz [not null]

  indexes {
    (company_id, metric_key, period_start) [unique, name: "usage_records_company_metric_period_unique"]
  }
}

Table background_tasks {
  id uuid [pk, not null]
  company_id uuid
  task_name varchar(150) [not null]
  payload jsonb [not null]
  status varchar(32) [not null, note: "Check: pending, running, succeeded, failed."]
  attempts integer [not null, default: 0]
  max_attempts integer [not null, default: 5]
  last_error text
  run_after timestamptz [not null]
  locked_at timestamptz
  finished_at timestamptz
  created_at timestamptz [not null]

  indexes {
    (status, run_after) [name: "background_tasks_status_run_after_idx"]
    company_id [name: "background_tasks_company_idx"]
  }
}

// ---------------------------------------------------------------------------
// HRMS Leave, the first optional module
// ---------------------------------------------------------------------------

Table hrms_leave_policies {
  id uuid [pk, not null]
  company_id uuid [not null]
  name varchar(150) [not null]
  annual_allowance_days numeric(6,2) [not null, note: "Day counts are numeric. This column is not money."]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (company_id, id) [unique, name: "hrms_leave_policies_company_id_id_unique"]
    (company_id, name) [unique, name: "hrms_leave_policies_company_name_unique"]
  }
}

Table hrms_leave_requests {
  id uuid [pk, not null]
  company_id uuid [not null]
  person_id uuid [not null]
  policy_id uuid [not null]
  start_date date [not null]
  end_date date [not null]
  status varchar(32) [not null, note: "Check: pending, approved, rejected, cancelled. Check: end_date >= start_date."]
  reason text [not null, default: ""]
  decided_by_user_id uuid
  decided_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (company_id, person_id, status) [name: "hrms_leave_requests_person_status_idx"]
    (company_id, start_date) [name: "hrms_leave_requests_company_start_idx"]
  }
}

// ---------------------------------------------------------------------------
// Relationships
// ---------------------------------------------------------------------------

Ref: email_verification_tokens.user_id > users.id
Ref: password_reset_tokens.user_id > users.id
Ref: companies.created_by_user_id > users.id
Ref: company_billing_profiles.company_id > companies.id
Ref: company_memberships.company_id > companies.id
Ref: company_memberships.user_id > users.id
Ref: membership_invitations.company_id > companies.id
Ref: membership_invitations.invited_by_user_id > users.id
Ref: membership_invitations.accepted_by_user_id > users.id
Ref: onboarding_states.company_id > companies.id
Ref: onboarding_states.owner_user_id > users.id
Ref: company_settings.company_id > companies.id
Ref: departments.company_id > companies.id
Ref: people.company_id > companies.id

Ref: people_department {
  people.(company_id, department_id) > departments.(company_id, id)
}

Ref: people_manager {
  people.(company_id, manager_person_id) > people.(company_id, id)
}

Ref: departments_parent {
  departments.(company_id, parent_department_id) > departments.(company_id, id)
}

Ref: memberships_person {
  company_memberships.(company_id, person_id) > people.(company_id, id)
}

Ref: invitations_person {
  membership_invitations.(company_id, person_id) > people.(company_id, id)
}

Ref: role_template_permissions.role_template_id > role_templates.id
Ref: role_template_permissions.permission_code > permissions.code
Ref: company_roles.company_id > companies.id

Ref: company_role_permissions_role {
  company_role_permissions.(company_id, company_role_id) > company_roles.(company_id, id)
}

Ref: company_role_permissions.permission_code > permissions.code

Ref: membership_role_membership {
  membership_role_assignments.(company_id, membership_id) > company_memberships.(company_id, id)
}

Ref: membership_role_role {
  membership_role_assignments.(company_id, company_role_id) > company_roles.(company_id, id)
}

Ref: membership_role_assignments.assigned_by_user_id > users.id
Ref: platform_permission_grants.user_id > users.id
Ref: platform_permission_grants.permission_code > permissions.code
Ref: platform_permission_grants.granted_by_user_id > users.id
Ref: permissions.module_slug > module_definitions.slug
Ref: module_dependencies.module_slug > module_definitions.slug
Ref: module_dependencies.depends_on_slug > module_definitions.slug
Ref: company_module_installations.company_id > companies.id
Ref: company_module_installations.module_slug > module_definitions.slug
Ref: company_module_installations.installed_by_user_id > users.id
Ref: billing_plan_prices.plan_id > billing_plans.id
Ref: billing_plan_entitlements.plan_id > billing_plans.id
Ref: billing_module_prices.module_slug > module_definitions.slug
Ref: billing_customers.company_id > companies.id
Ref: billing_payment_methods.company_id > companies.id

Ref: billing_payment_methods_customer {
  billing_payment_methods.(company_id, billing_customer_id) > billing_customers.(company_id, id)
}
Ref: subscriptions.company_id > companies.id
Ref: subscriptions.plan_id > billing_plans.id
Ref: subscriptions.plan_price_id > billing_plan_prices.id

Ref: subscription_items_subscription {
  subscription_items.(company_id, subscription_id) > subscriptions.(company_id, id)
}

Ref: subscription_items.plan_price_id > billing_plan_prices.id
Ref: subscription_items.module_price_id > billing_module_prices.id
Ref: subscription_items.module_slug > module_definitions.slug

Ref: subscription_events_subscription {
  subscription_status_events.(company_id, subscription_id) > subscriptions.(company_id, id)
}

Ref: subscription_status_events.provider_event_id > payment_provider_events.id
Ref: subscription_status_events.actor_user_id > users.id

Ref: invoices.company_id > companies.id

Ref: invoices_subscription {
  invoices.(company_id, subscription_id) > subscriptions.(company_id, id)
}

Ref: invoice_lines_invoice {
  invoice_lines.(company_id, invoice_id) > invoices.(company_id, id)
}

Ref: invoice_lines_subscription_item {
  invoice_lines.(company_id, subscription_item_id) > subscription_items.(company_id, id)
}

Ref: invoice_tax_line {
  invoice_tax_components.(company_id, invoice_line_id) > invoice_lines.(company_id, id)
}

Ref: invoice_tax_invoice {
  invoice_tax_components.(company_id, invoice_id) > invoices.(company_id, id)
}

Ref: payment_transactions.company_id > companies.id

Ref: payment_transactions_invoice {
  payment_transactions.(company_id, invoice_id) > invoices.(company_id, id)
}

Ref: payment_transactions_subscription {
  payment_transactions.(company_id, subscription_id) > subscriptions.(company_id, id)
}

Ref: refunds.company_id > companies.id

Ref: refunds_payment {
  refunds.(company_id, payment_transaction_id) > payment_transactions.(company_id, id)
}

Ref: refunds_invoice {
  refunds.(company_id, invoice_id) > invoices.(company_id, id)
}

Ref: refunds.created_by_user_id > users.id
Ref: widget_definitions.module_slug > module_definitions.slug
Ref: widget_definitions.required_permission > permissions.code
Ref: dashboards.company_id > companies.id
Ref: dashboards.created_by_user_id > users.id

Ref: dashboards_published_version {
  dashboards.(company_id, published_version_id) > dashboard_versions.(company_id, id)
}

Ref: dashboard_versions_dashboard {
  dashboard_versions.(company_id, dashboard_id) > dashboards.(company_id, id)
}

Ref: dashboard_versions.created_by_user_id > users.id

Ref: dashboard_widgets_version {
  dashboard_widgets.(company_id, dashboard_version_id) > dashboard_versions.(company_id, id)
}

Ref: dashboard_widgets.widget_code > widget_definitions.code

Ref: dashboard_assignments_dashboard {
  dashboard_assignments.(company_id, dashboard_id) > dashboards.(company_id, id)
}

Ref: dashboard_assignments_role {
  dashboard_assignments.(company_id, company_role_id) > company_roles.(company_id, id)
}

Ref: dashboard_assignments_membership {
  dashboard_assignments.(company_id, membership_id) > company_memberships.(company_id, id)
}

Ref: notifications.company_id > companies.id
Ref: notifications.recipient_user_id > users.id

Ref: notifications_membership {
  notifications.(company_id, membership_id) > company_memberships.(company_id, id)
}

Ref: audit_logs.company_id > companies.id
Ref: audit_logs.actor_user_id > users.id
Ref: usage_records.company_id > companies.id
Ref: background_tasks.company_id > companies.id
Ref: hrms_leave_policies.company_id > companies.id

Ref: hrms_leave_requests_person {
  hrms_leave_requests.(company_id, person_id) > people.(company_id, id)
}

Ref: hrms_leave_requests_policy {
  hrms_leave_requests.(company_id, policy_id) > hrms_leave_policies.(company_id, id)
}

Ref: hrms_leave_requests.decided_by_user_id > users.id

TableGroup identity {
  users
  email_verification_tokens
  password_reset_tokens
}

TableGroup tenants {
  companies
  company_billing_profiles
  company_memberships
  membership_invitations
  onboarding_states
  company_settings
}

TableGroup organization {
  departments
  people
}

TableGroup authorization {
  permissions
  role_templates
  role_template_permissions
  company_roles
  company_role_permissions
  membership_role_assignments
  platform_permission_grants
}

TableGroup modules {
  module_definitions
  module_dependencies
  company_module_installations
}

TableGroup billing {
  billing_plans
  billing_plan_prices
  billing_plan_entitlements
  billing_module_prices
  billing_customers
  billing_payment_methods
  subscriptions
  subscription_items
  subscription_status_events
  invoice_sequences
  invoices
  invoice_lines
  invoice_tax_components
  payment_transactions
  refunds
  payment_provider_events
  platform_supplier_profile
  platform_tax_rates
  platform_settings
}

TableGroup dashboards {
  widget_definitions
  dashboards
  dashboard_versions
  dashboard_widgets
  dashboard_assignments
}

TableGroup operations {
  notifications
  audit_logs
  usage_records
  background_tasks
}

TableGroup hrms {
  hrms_leave_policies
  hrms_leave_requests
}
